# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | production ("production" disables the Swagger UI)
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=INFO
# text (development) | json (one JSON object per line, for log collectors). Both include the request ID.
LOG_FORMAT=text
# When set, GET /metrics needs "Authorization: Bearer <METRICS_TOKEN>". Empty = open: then do not expose
# /metrics publicly (restrict it at the reverse proxy or network).
METRICS_TOKEN=
# Comma-separated list of allowed browser origins. Empty = CORS disabled.
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BODY_BYTES=65536

# ---------------------------------------------------------------------------
# System database (users, metadata, encrypted connection info)
# Inside docker compose the host is the service name "system-db".
# ---------------------------------------------------------------------------
SYSTEM_DB_HOST=system-db
SYSTEM_DB_PORT=5432
SYSTEM_DB_NAME=discovery
SYSTEM_DB_USER=discovery
SYSTEM_DB_PASSWORD=change-me-system-db

# ---------------------------------------------------------------------------
# Authentication
# The admin user is created from these values at startup and stored with an
# Argon2 hash. Changing AUTH_PASSWORD and restarting updates the stored hash.
# ---------------------------------------------------------------------------
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-admin
# At least 32 characters. The value below is for local development only and is
# rejected when APP_ENV=production. Generate a real one with: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Failed-login throttling for /auth and Basic credentials (in memory, per process; 0 disables a limit).
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_MAX_FAILED_ATTEMPTS_PER_IP=20
AUTH_FAILURE_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# Encryption of stored target DB passwords (AES-256-GCM)
# Must be base64 of exactly 32 bytes. The value below is for local development
# only and is rejected when APP_ENV=production. Generate a real one with:
#   openssl rand -base64 32
# Changing it makes previously stored connections unreadable (see README "Key rotation").
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# ---------------------------------------------------------------------------
# LLM (any OpenAI-compatible API)
# Local alternative (keeps PII on your machine): the compose "local-llm" profile
#   docker compose --profile local-llm up -d
#   docker compose exec ollama ollama pull llama3.1
# then set:
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_API_KEY=            (empty: Ollama needs no key)
#   LLM_MODEL=llama3.1
#   LLM_TIMEOUT=300         (CPU-only inference is slow)
# Ollama installed on the host instead: LLM_BASE_URL=http://host.docker.internal:11434/v1
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Seconds
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# Sends response_format={"type": "json_object"}; set false if your provider rejects it.
LLM_JSON_MODE=true

# ---------------------------------------------------------------------------
# Target database access and sampling
# ---------------------------------------------------------------------------
TARGET_DB_CONNECT_TIMEOUT_SECONDS=10
TARGET_DB_STATEMENT_TIMEOUT_MS=15000
# Comma-separated hostnames, IPs or CIDRs targets may use. Empty = any host except the system DB,
# loopback, link-local/cloud metadata, multicast and reserved addresses. Set this in production.
TARGET_DB_ALLOWED_HOSTS=
# TLS to target databases: disable | prefer | require | verify-ca | verify-full (production: verify-full).
TARGET_DB_SSL_MODE=prefer
# PEM CA bundle for verify-ca / verify-full; empty = JVM trust store.
TARGET_DB_SSL_ROOT_CERT=
MAX_SAMPLE_COUNT=100
# none | partial | strict (see README "Sample masking")
SAMPLE_MASKING_MODE=partial
# Fuse deterministic checks (TCKN check digits, Luhn) on the raw samples into the LLM result
CHECKSUM_VALIDATION_ENABLED=true
# Reuse a classification while the column's samples and the LLM settings are unchanged (0 disables)
CLASSIFICATION_CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Demo target database (docker compose service "demo-db")
# ---------------------------------------------------------------------------
DEMO_DB_NAME=llm_discovery_demo
DEMO_DB_USER=demo
DEMO_DB_PASSWORD=change-me-demo-db
# SELECT-only login created in demo-db for the discovery service (least privilege).
# Use it, not DEMO_DB_USER, when scanning the demo DB.
DEMO_DB_READONLY_USER=discovery_reader
DEMO_DB_READONLY_PASSWORD=change-me-demo-reader
DEMO_DB_EXPOSED_PORT=5434
